{
  "name": "@burlesquer/openclaw-kakao",
  "version": "0.5.0",
  "description": "OpenClaw Kakao plugin for KakaoTalk channel integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "index.ts",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests index.ts",
    "typecheck": "tsc --noEmit"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "openclaw-kakao",
      "label": "OpenClaw Kakao",
      "selectionLabel": "카카오톡 채널",
      "docsPath": "/channels/openclaw-kakao",
      "docsLabel": "openclaw-kakao",
      "blurb": "KakaoTalk 채널 챗봇을 OpenClaw에 연결합니다",
      "order": 80,
      "quickstartAllowFrom": false
    },
    "compatibility": {
      "testedWith": "2026.2.20"
    },
    "install": {
      "localPath": "extensions/openclaw-kakao",
      "defaultChoice": "local"
    }
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.1.29"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^9.21.0",
    "openclaw": "2026.2.13",
    "typescript-eslint": "^8.24.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/burlesquer/openclaw-kakao.git"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
